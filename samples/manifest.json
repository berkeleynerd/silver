          "expected": {
            "stdout": "",
            "stderr": "",
            "exit_status": 1
          }
        },
        {
          "arguments": [
            "\u0001"
          ],
          "expected": {
            "stdout": "",
            "stderr": "",
            "exit_status": 1
          }
        }
