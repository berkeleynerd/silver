          ],
          "expected": {
            "stdout": "Initial: ready; current: quiet\nquiet\n",
            "stderr": "",
            "exit_status": 0
          }
        },
        {
          "arguments": [
            ""
          ],
          "expected": {
            "stdout": "Initial: ready; current: empty\n\n",
            "stderr": "",
            "exit_status": 0
          }
        },
        {
          "arguments": [
            "other"
          ],
          "expected": {
            "stdout": "Initial: ready; current: ready\nother\n",
            "stderr": "",
            "exit_status": 0
          }
        },
        {
          "arguments": [
            "verbose",
            "extra"
