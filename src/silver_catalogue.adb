   procedure Form_Tokens
     (Field : String; Form : Silver_Output_Profile.Form_Kind; Last : Boolean := False)
     with Global => (In_Out => Ada.Text_IO.File_System), Pre => Field'Length <= 64
   is
      use Silver_Output_Profile;
      Sequence : constant Token_Sequence := Tokens (Form);
   begin
      Put ("  """ & Field & """: [");
      for Index in Sequence'Range loop
         if Index /= Sequence'First then Put (","); end if;
         case Sequence (Index) is
            when String_Literal => Put ("""<string_literal>""");
            when Argument_Declaration => Put ("""<argument_declaration>""");
            when Context_Clauses => Put ("""<context_clauses>""");
            when Declarations => Put ("""<declarations>""");
            when Statements => Put ("""<statements>""");
            when Assignment_Target => Put ("""<assignment_target>""");
            when Target_Reference => Put ("""<target_reference>""");
            when Dynamic_Reference => Put ("""<dynamic_reference>""");
            when Assignment_Value => Put ("""<assignment_value>""");
            when Output_Expression => Put ("""<string_expression>""");
            when Comparison_Expression => Put ("""<string_comparison>""");
            when Capacity_Literal => Put ("""<capacity_literal>""");
            when others => Put ("""" & Spelling (Sequence (Index)) & """");
         end case;
      end loop;
      Put_Line ((if Last then "]" else "],"));
   end Form_Tokens;

   procedure Export_Tokens
     with Global => (In_Out => Ada.Text_IO.File_System)
   is
      Word_Written : Boolean := False;
   begin
      Put ("  ""word_tokens"": [");
      for Token in Silver_Profile.Token_Kind loop
         if Silver_Profile.Is_Word_Token (Token) then
            if Word_Written then Put (","); end if;
            Put ("""" & Silver_Profile.Spelling (Token) & """");
            Word_Written := True;
         end if;
      end loop;
      for Token in Silver_Output_Profile.Token_Kind loop
         if Token in Silver_Output_Profile.With_Keyword | Silver_Output_Profile.IO_Name | Silver_Output_Profile.Put_Line_Name
           | Silver_Output_Profile.Constant_Keyword | Silver_Output_Profile.String_Name
           | Silver_Output_Profile.Arguments_Name | Silver_Output_Profile.First_Or_Default_Name
           | Silver_Output_Profile.If_Keyword | Silver_Output_Profile.Input_Is_Valid_Name
           | Silver_Output_Profile.Then_Keyword | Silver_Output_Profile.Else_Keyword
           | Silver_Output_Profile.Elsif_Keyword
           | Silver_Output_Profile.Reject_Name
           | Silver_Output_Profile.And_Keyword | Silver_Output_Profile.Length_Name
           | Silver_Output_Profile.Or_Keyword | Silver_Output_Profile.Not_Keyword
         then
            Put (",""" & Silver_Output_Profile.Spelling (Token) & """");
         end if;
      end loop;
      Put_Line (",""use"",""item"",""default"",""put""],");
      Put ("  ""casefold_bytes"": [");
      for Item in Character loop
         if Item /= Character'First then Put (","); end if;
         Put (Decimal (Character'Pos (Silver_Profile.Lowercase (Item))));
      end loop;
      Put_Line ("],");
      Put ("  ""null_tokens"": [");
      for Index in Silver_Profile.Required_Tokens'Range loop
         if Index /= Silver_Profile.Required_Tokens'First then Put (","); end if;
         Put ("""" & Silver_Profile.Spelling (Silver_Profile.Required_Tokens (Index)) & """");
      end loop;
      Put_Line ("],");
      Put_Line ("  ""with_clause_tokens"": [""with"",""<package_list>"","";""],");
      Put_Line ("  ""use_clause_tokens"": [""use"",""<previously_withed_package_list>"","";""],");
      Put_Line ("  ""named_output_actual_tokens"": [""item"",""=>"",""<string_expression>""],");
      Put_Line ("  ""named_argument_actual_tokens"": [""default"",""=>"",""<string_literal>""],");
      Put_Line ("  ""constant_declaration_tokens"": [""<declaration_name>"","":"",""constant"",""string"","":="",""<string_expression>"","";""],");
      Put_Line ("  ""variable_declaration_tokens"": [""<declaration_name>"","":"",""string"","":="",""<string_expression>"","";""],");
      Put_Line ("  ""argument_declaration_tokens"": [""<declaration_name>"","":"",""constant"",""string"","":="",""silver_arguments"",""."",""first_or_default"",""("",""<string_literal>"","")"","";""],");
      Put_Line ("  ""null_statement_tokens"": [""null"","";""],");
      Put_Line ("  ""assignment_statement_tokens"": [""<assignment_target>"","":="",""<string_expression>"","";""],");
      Put_Line ("  ""output_statement_tokens"": [""silver_io"",""."",""put_line"",""("",""<string_expression>"","")"","";""],");
      Put_Line ("  ""partial_output_statement_tokens"": [""silver_io"",""."",""put"",""("",""<string_expression>"","")"","";""],");
      Put_Line ("  ""choice_statement_tokens"": [""if"",""<condition>"",""then"",""<statements>"",""<elsif_arms>"",""<optional_else>"",""end"",""if"","";""],");
      Put_Line ("  ""elsif_arm_tokens"": [""elsif"",""<condition>"",""then"",""<statements>""],");
      Put_Line ("  ""else_arm_tokens"": [""else"",""<statements>""],");
      Put_Line ("  ""reject_statement_tokens"": [""silver_arguments"",""."",""reject"","";""],");
      Put_Line ("  ""validity_predicate_tokens"": [""silver_arguments"",""."",""input_is_valid""],");
      Put_Line ("  ""string_relation_tokens"": [""<string_expression>"",""<equality_or_inequality>"",""<string_expression>""],");
      Put_Line ("  ""length_relation_tokens"": [""<initialized_name>"",""'"",""length"",""<length_comparison>"",""<length_operand>""],");
      Put_Line ("  ""grouped_condition_tokens"": [""("",""<condition>"","")""],");
      Put_Line ("  ""negated_primary_tokens"": [""not"",""<primary>""],");
      Put_Line ("  ""and_then_tokens"": [""<relation>"",""and"",""then"",""<relation>""],");
      Put_Line ("  ""or_else_tokens"": [""<relation>"",""or"",""else"",""<relation>""],");
      Form_Tokens ("output_tokens", Silver_Output_Profile.Direct_Form);
      Form_Tokens ("argument_tokens", Silver_Output_Profile.Argument_Form, Last => True);
   end Export_Tokens;

