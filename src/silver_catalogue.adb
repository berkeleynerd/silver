   procedure Export_Rules
     with Global => (In_Out => Ada.Text_IO.File_System)
   is
   begin
      Put_Line ("  ""additional_units"": false,");
      Put_Line ("  ""additional_constructs"": false,");
      Put_Line ("  ""procedure_name"": ""Main"",");
      Put_Line ("  ""source_encoding"": ""ASCII"",");
      Put_Line ("  ""comment_ends_at_eof"": true,");
      Put_Line ("  ""comment_printable_bytes"": [");
      Put_Line ("    32,");
      Put_Line ("    126");
      Put_Line ("  ],");
      Put_Line ("  ""comment_tab_allowed"": true,");
      Put_Line ("  ""ascii_case_insensitive"": true,");
      Put_Line ("  ""literal_case_preserved"": true,");
      Put_Line ("  ""whole_identifier_tokens"": true,");
      Put_Line ("  ""output"": {");
      Put_Line ("    ""operation"": ""Silver_IO.Put_Line"",");
      Put_Line ("    ""stream"": ""stdout"",");
      Put_Line ("    ""appended_bytes"": [");
      Put_Line ("      10");
      Put_Line ("    ],");
      Put_Line ("    ""completion"": ""successful fflush(NULL)"",");
      Put_Line ("    ""detected_failure_exit_status"": 1,");
      Put_Line ("    ""external_signal_failure"": ""nonzero termination"",");
      Put_Line ("    ""partial_output_on_failure"": true");
      Put_Line ("  },");
      Put_Line ("  ""argument_input"": {");
      Put_Line ("    ""operation"": ""Silver_Arguments.First_Or_Default"",");
      Put_Line ("    ""validity_operation"": ""Silver_Arguments.Input_Is_Valid"",");
      Put_Line ("    ""maximum_arguments"": 1,");
      Put_Line ("    ""max_argument_bytes"": 4096,");
      Put_Line ("    ""argument_byte_range"": [");
      Put_Line ("      32,");
      Put_Line ("      126");
      Put_Line ("    ],");
      Put_Line ("    ""missing"": ""supplied_default"",");
      Put_Line ("    ""empty"": ""preserved"",");
      Put_Line ("    ""invalid_exit_status"": 1,");
      Put_Line ("    ""invalid_stdout"": """",");
      Put_Line ("    ""selected_value_first"": 1,");
      Put_Line ("    ""immutable_argument_vector_required"": true");
      Put_Line ("  },");
      Put_Line ("  ""max_source_bytes"":" & Decimal (Silver_Profile.Max_Source_Length) & ",");
      Put_Line ("  ""max_expression_operands"":" & Decimal (Silver_Output_Profile.Max_Expression_Operands) & ",");
      Bytes ("whitespace_bytes", Whitespace);
      Bytes ("allowed_source_bytes", Allowed);
      Bytes ("identifier_bytes", Identifier);
      Put_Line ("  ""comment_prefix"": """ & Silver_Profile.Comment_Introducer & """,");
      Bytes ("comment_end_bytes", Comment_End);
   end Export_Rules;

   procedure Form_Tokens
     (Field : String; Form : Silver_Output_Profile.Form_Kind; Last : Boolean := False)
     with Global => (In_Out => Ada.Text_IO.File_System), Pre => Field'Length <= 64
   is
      use Silver_Output_Profile;
      Sequence : constant Token_Sequence := Tokens (Form);
   begin
      Put ("  """ & Field & """: [");
      for Index in Sequence'Range loop
         if Index /= Sequence'First then Put (","); end if;
         case Sequence (Index) is
            when String_Literal => Put ("""<string_literal>""");
            when Declaration_Name => Put ("""<static_declaration>""");
            when Reference_Name => Put ("""<static_reference>""");
            when Dynamic_Declaration => Put ("""<dynamic_declaration>""");
            when Dynamic_Reference => Put ("""<dynamic_reference>""");
            when Static_Initializer => Put ("""<static_initializer>""");
            when Static_Assignment => Put ("""<static_assignment>""");
            when Output_Expression => Put ("""<string_expression>""");
            when Capacity_Literal => Put ("""<capacity_literal>""");
            when Constant_One_Declaration => Put ("""<constant_one_declaration>""");
            when Constant_Two_Declaration => Put ("""<constant_two_declaration>""");
            when Constant_One_Initializer => Put ("""<constant_one_initializer>""");
            when Constant_Two_Initializer => Put ("""<constant_two_initializer>""");
            when others => Put ("""" & Spelling (Sequence (Index)) & """");
         end case;
      end loop;
      Put_Line ((if Last then "]" else "],"));
   end Form_Tokens;

   procedure Export_Tokens
     with Global => (In_Out => Ada.Text_IO.File_System)
   is
      Word_Written : Boolean := False;
   begin
      Put ("  ""word_tokens"": [");
      for Token in Silver_Profile.Token_Kind loop
         if Silver_Profile.Is_Word_Token (Token) then
            if Word_Written then Put (","); end if;
            Put ("""" & Silver_Profile.Spelling (Token) & """");
            Word_Written := True;
         end if;
      end loop;
      for Token in Silver_Output_Profile.Token_Kind loop
         if Token in Silver_Output_Profile.With_Keyword | Silver_Output_Profile.IO_Name | Silver_Output_Profile.Put_Line_Name
           | Silver_Output_Profile.Constant_Keyword | Silver_Output_Profile.String_Name
           | Silver_Output_Profile.Arguments_Name | Silver_Output_Profile.First_Or_Default_Name
           | Silver_Output_Profile.If_Keyword | Silver_Output_Profile.Input_Is_Valid_Name
           | Silver_Output_Profile.Then_Keyword | Silver_Output_Profile.Else_Keyword
           | Silver_Output_Profile.Reject_Name
           | Silver_Output_Profile.And_Keyword | Silver_Output_Profile.Length_Name
         then
            Put (",""" & Silver_Output_Profile.Spelling (Token) & """");
         end if;
      end loop;
      Put_Line ("],");
      Put ("  ""casefold_bytes"": [");
      for Item in Character loop
         if Item /= Character'First then Put (","); end if;
         Put (Decimal (Character'Pos (Silver_Profile.Lowercase (Item))));
      end loop;
      Put_Line ("],");
      Put ("  ""null_tokens"": [");
      for Index in Silver_Profile.Required_Tokens'Range loop
         if Index /= Silver_Profile.Required_Tokens'First then Put (","); end if;
         Put ("""" & Silver_Profile.Spelling (Silver_Profile.Required_Tokens (Index)) & """");
      end loop;
      Put_Line ("],");
      Form_Tokens ("output_tokens", Silver_Output_Profile.Direct_Form);
      Form_Tokens ("named_tokens", Silver_Output_Profile.Static_Form);
      Form_Tokens ("assignment_tokens", Silver_Output_Profile.Assignment_Form);
      Form_Tokens ("argument_tokens", Silver_Output_Profile.Argument_Form);
      Form_Tokens ("guarded_argument_tokens", Silver_Output_Profile.Guarded_Argument_Form);
      Form_Tokens ("branching_tokens", Silver_Output_Profile.Branching_Form);
      Form_Tokens ("guarded_branching_tokens", Silver_Output_Profile.Guarded_Branching_Form);
      Form_Tokens ("result_tokens", Silver_Output_Profile.Result_Form);
      Form_Tokens ("guarded_result_tokens", Silver_Output_Profile.Guarded_Result_Form);
      Form_Tokens ("assignment_one_tokens", Silver_Output_Profile.Assignment_One_Form);
      Form_Tokens ("assignment_two_tokens", Silver_Output_Profile.Assignment_Two_Form);
      Form_Tokens ("result_one_tokens", Silver_Output_Profile.Result_One_Form);
      Form_Tokens ("result_two_tokens", Silver_Output_Profile.Result_Two_Form);
      Form_Tokens ("guarded_result_one_tokens", Silver_Output_Profile.Guarded_Result_One_Form);
      Form_Tokens ("guarded_result_two_tokens", Silver_Output_Profile.Guarded_Result_Two_Form, Last => True);
   end Export_Tokens;

   procedure Export is
   begin
      Put_Line ("{");
      Put_Line ("  ""schema_version"": 1,");
      Put_Line ("  ""profile"": ""silver"",");
      Export_Constructs;
      Export_Compositions;
      Export_Rules;
      Export_Tokens;
      Put_Line ("}");
   end Export;
end Silver_Catalogue;
