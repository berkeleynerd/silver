structure Checked (tokens : List String) : Prop where
  trees : CheckedHelperTrees
  headers : ∀ item ∈ headers, functionHeader item.1 item.2.1 tokens = some item.2.2
  expressions : ∀ item ∈ expressions, expressionDeclaration item.1 tokens = some (item.2.1, item.2.2)
  ordinary : ∀ item ∈ ordinary, BooleanDeclarationNative.SourceChecks.ordinaryFunction item.1 tokens = some item.2
  loops : ∀ item ∈ loops, BooleanDeclarationNative.SourceChecks.ordinaryFunction item.1 tokens = some item.2
  stepResult : Silver.Lexical.SourceBridge.recordDeclaration "procedure_parameter_step_result" tokens =
    some ["record", "state", ":", "parser_state", ";", "closed", ":", "boolean", ";", "end", "record"]
  parameterCursor : Silver.Lexical.SourceBridge.subtypeDeclaration "procedure_parameter_cursor" tokens =
    some ["positive", "range", "1", "..", "procedures", ".", "max_formals", "+", "1"]

end Silver.Compose.ProcedureDeclarationNative.HelperSourceChecks
