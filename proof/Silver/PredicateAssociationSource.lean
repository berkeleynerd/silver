def markFormalSpec : List String := ["(", "seen", ":", "formal_set", ";", "formal", ":", "functions", ".", "formal_index", ")", "return", "formal_set", "with", "global", "=>", "null", ",", "post", "=>", "(", "for", "all", "index", "in", "functions", ".", "formal_index", "=>", "mark_formal", "'", "result", "(", "index", ")", "=", "(", "if", "index", "=", "formal", "then", "true", "else", "seen", "(", "index", ")", ")", ")"]

def markFormalImpl : List String := ["(", "seen", ":", "formal_set", ";", "formal", ":", "functions", ".", "formal_index", ")", "return", "formal_set"]

/-- The native delta's finite array interpretation is the shared semantic
update on every stored cell, with the exact Formal_Index subtype domain. -/
theorem markFormal_storage (storage : FormalStorage) (formal : Nat)
    (bound : 0 < formal ∧ formal ≤ FunctionBindings.maxFormals) :
    markFormalBody.eval modelCalls ({seen := storage.read, formal} : Frame).locals =
      (storage.mark formal).read := by
  rw [markFormal_model, FormalStorage.read_mark storage formal bound]

structure Checked (tokens : List String) : Prop where
  trees : CheckedTrees
  markFormalSpec : functionHeader "mark_formal" ";" tokens = some markFormalSpec
  markFormalImpl : functionHeader "mark_formal" "is" tokens = some markFormalImpl
  -- Delta aggregate and expression function share their outer parentheses.
  markFormalBody : (Source.expressionBody "mark_formal" tokens).map (fun body => ["("] ++ body ++ [")"]) =
    some markFormalBody.render
  headers : ∀ item ∈ headers, functionHeader item.1 item.2.1 tokens = some item.2.2
  expressions : ∀ item ∈ expressions, expressionDeclaration item.1 tokens = some (item.2.1, item.2.2)
  loops : ∀ item ∈ loops, Compose.BooleanDeclarationNative.SourceChecks.ordinaryFunction item.1 tokens = some item.2
  formalSet : typeDeclaration "formal_set" tokens =
    some ["array", "(", "functions", ".", "formal_index", ")", "of", "boolean"]
  noFormals : Source.declaration "no_formals" tokens =
    some ["constant", "formal_set", ":=", "(", "others", "=>", "false", ")"]
  association : Silver.Lexical.SourceBridge.recordDeclaration "actual_association" tokens =
    some ["record", "formal", ":", "functions", ".", "formal_count", ";", "payload_first", ":", "literal_position", ";", "named", ":", "boolean", ";", "end", "record"]
  invalidAssociation : Source.declaration "invalid_association" tokens =
    some ["constant", "actual_association", ":=", "(", "0", ",", "0", ",", "false", ")"]

end Silver.Predicate.AssociationNative.SourceChecks
