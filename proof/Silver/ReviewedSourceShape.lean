/-- An inserted declaration cannot disappear from the complete shape check,
regardless of whether any selected function lookup notices its designator. -/
theorem insertion_changes_shape (before added after : Silver.Source.Tokens)
    (nonempty : added ≠ []) : before ++ added ++ after ≠ before ++ after := by
  intro equal
  have lengths := congrArg List.length equal
  have positive : 0 < added.length := List.length_pos_iff.mpr nonempty
  simp only [List.length_append] at lengths
  omega

/-- Regression for a visible overload. Its tokens are nonempty, so full-scope
checking rejects it even though individual body/name lookups would ignore it. -/
theorem operator_insertion_rejected (before after : Silver.Source.Tokens) :
    before ++ ["function", "\"=\"", "(", "l", ",", "r", ":", "character", ")",
      "return", "boolean", "is", "(", "true", ")", ";"] ++ after ≠ before ++ after :=
  insertion_changes_shape before _ after (by decide)

/-- A fresh candidate reflecting a changed source constant cannot preserve the
reviewed shape, independently of whether old line certificates are retained. -/
theorem source_limit_replacement_rejected :
    specification.map (fun token => if token == "4_096" then "4_095" else token) ≠
      specification := by decide +kernel

