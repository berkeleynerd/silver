import Silver.Admission

/-!
Semantics and assurance for the initial, null-only Silver profile.

The inherited semantic clauses used here are Ada 2022 RM 5.1 (a null statement
performs no action), RM 6.3/6.4 (execution and normal return of a procedure body),
and SPARK 16.1's SPARK_Mode declaration (selection of analysis, with no added
executable computation). There are no objects or parameters to initialize and
no expression, assignment, call, handler, or explicit raise in the admitted AST.

`Command.sequence` is a semantic composition operation. Its presence in this
proof does not admit additional statements in Silver source: `SourceMeaning`
has exactly the catalogue production already proved by `Silver.Admission`.

`automaticDischarge` is the terminating mathematical procedure for the
obligations generated by this restricted semantics. Its theorem does NOT say
that an external GNATprove process cannot crash, time out, or fail. Correspondence
to the configured GNATprove checks, tool completion, generated startup, and the
operating-system/runtime behavior remain separate implementation/trust claims.
This module neither implements nor claims a semantics for arbitrary Ada.
-/

namespace Silver
namespace Semantics

/-- Arbitrary surrounding memory, including potentially uninitialized cells. -/
abbrev State := Nat → Option Int

inductive Event
  | read (location : Nat)
  | write (location : Nat) (value : Int)
  | call (callee : Nat)
  deriving DecidableEq, Repr

abbrev Trace := List Event

/-- Source-level exceptional outcomes, absent from executions proved below. -/
inductive Fault
  | overflow | range | index | divisionByZero | invalidAccess | assertion | explicitRaise
  deriving DecidableEq, Repr

inductive Outcome
  | normal (state : State)
  | raised (fault : Fault)

/-- Semantic constructors needed for the sole admitted source production. -/
inductive Command
  | nullStatement
  | sparkModeOn
  | sequence (first second : Command)
  | main (body : Command)
  deriving DecidableEq, Repr

def admittedCommand : Command :=
  .main (.sequence .sparkModeOn .nullStatement)

/-- A source interpretation follows the actual fixed token production. -/
inductive SourceMeaning : Source → Command → Prop
  | main {source : Source} : Parsed requiredTokens source →
      SourceMeaning source admittedCommand

theorem member_has_meaning {source : Source} (h : Member source) :
    SourceMeaning source admittedCommand :=
  .main h.2.2.2

theorem meaning_unique {source : Source} {command : Command}
    (h : SourceMeaning source command) : command = admittedCommand := by
  cases h
  rfl

/-- Big-step execution includes normal sequencing and exception propagation. -/
inductive Executes : Command → State → Trace → Outcome → Prop
  | nullStatement (state : State) :
      Executes .nullStatement state [] (.normal state)
  | sparkModeOn (state : State) :
      Executes .sparkModeOn state [] (.normal state)
  | sequence {first second : Command} {state intermediate : State}
      {left right : Trace} {outcome : Outcome} :
      Executes first state left (.normal intermediate) →
      Executes second intermediate right outcome →
      Executes (.sequence first second) state (left ++ right) outcome
  | sequenceFault {first second : Command} {state : State} {trace : Trace} {fault : Fault} :
      Executes first state trace (.raised fault) →
      Executes (.sequence first second) state trace (.raised fault)
  | main {body : Command} {state : State} {trace : Trace} {outcome : Outcome} :
      Executes body state trace outcome → Executes (.main body) state trace outcome

/-- Structural recursion makes the semantic evaluator a total function. -/
def execute : Command → State → Trace × Outcome
  | .nullStatement, state => ([], .normal state)
  | .sparkModeOn, state => ([], .normal state)
  | .sequence first second, state =>
      match execute first state with
      | (left, .normal intermediate) =>
          let (right, outcome) := execute second intermediate
          (left ++ right, outcome)
      | (trace, .raised fault) => (trace, .raised fault)
  | .main body, state => execute body state

theorem execute_identity (command : Command) (state : State) :
    execute command state = ([], .normal state) := by
  induction command generalizing state with
  | nullStatement => rfl
  | sparkModeOn => rfl
  | sequence first second ihFirst ihSecond => simp [execute, ihFirst, ihSecond]
  | main body ih => exact ih state

/-- Every semantic composition has a finite execution derivation. -/
theorem execution_exists (command : Command) (state : State) :
    Executes command state [] (.normal state) := by
  induction command with
  | nullStatement => exact .nullStatement state
  | sparkModeOn => exact .sparkModeOn state
  | sequence first second ihFirst ihSecond => exact .sequence ihFirst ihSecond
  | main body ih => exact .main ih

/-- This quantifies over every possible derivation, including exceptional rules. -/
theorem execution_identity {command : Command} {state : State}
    {trace : Trace} {outcome : Outcome} (h : Executes command state trace outcome) :
    trace = [] ∧ outcome = .normal state := by
  induction h with
  | nullStatement => exact ⟨rfl, rfl⟩
  | sparkModeOn => exact ⟨rfl, rfl⟩
  | sequence hFirst hSecond ihFirst ihSecond =>
      cases ihFirst.2
      exact ⟨by simp [ihFirst.1, ihSecond.1], ihSecond.2⟩
  | sequenceFault hFirst ih => cases ih.2
  | main hBody ih => exact ih

def InitializedReads (state : State) (trace : Trace) : Prop :=
  ∀ location, Event.read location ∈ trace → ∃ value, state location = some value

/-- The parameterless, declaration-free program has an empty global footprint. -/
def NoGlobalAccess (trace : Trace) : Prop :=
  (∀ location, Event.read location ∉ trace) ∧
    (∀ location value, Event.write location value ∉ trace)

def NoCalls (trace : Trace) : Prop :=
  ∀ callee, Event.call callee ∉ trace

def BronzeSafe (state : State) (trace : Trace) : Prop :=
  InitializedReads state trace ∧ NoGlobalAccess trace ∧ NoCalls trace

def SilverSafe (outcome : Outcome) : Prop :=
  ∃ state, outcome = Outcome.normal state

theorem execution_safe {command : Command} {state : State}
    {trace : Trace} {outcome : Outcome} (h : Executes command state trace outcome) :
    BronzeSafe state trace ∧ SilverSafe outcome := by
  obtain ⟨rfl, rfl⟩ := execution_identity h
  constructor
  · simp [BronzeSafe, InitializedReads, NoGlobalAccess, NoCalls]
  · exact ⟨state, rfl⟩

theorem execution_has_no_exception {command : Command} {state : State}
    {trace : Trace} {fault : Fault} : ¬ Executes command state trace (.raised fault) := by
  intro h
  have impossible := (execution_identity h).2
  cases impossible

/-- The kinds distinguish initialization/flow checks from run-time checks. -/
inductive ObligationKind
  | initialization | dataFlow | runTimeSafety
  deriving DecidableEq, Repr

structure Obligation where
  kind : ObligationKind
  condition : Bool
  deriving DecidableEq, Repr

/--
Generation by syntax: the two primitive constructs evaluate no expression and
access no data; sequence unions the required checks, and a parameterless Main
with no object declarations introduces no argument or initialization checks.
-/
def obligations : Command → List Obligation
  | .nullStatement => []
  | .sparkModeOn => []
  | .sequence first second => obligations first ++ obligations second
  | .main body => obligations body

theorem obligations_empty (command : Command) : obligations command = [] := by
  induction command with
  | nullStatement => rfl
  | sparkModeOn => rfl
  | sequence first second ihFirst ihSecond => simp [obligations, ihFirst, ihSecond]
  | main body ih => exact ih

/-- A finite checker which rejects any false obligation, rather than dropping it. -/
def discharge : List Obligation → Bool
  | [] => true
  | obligation :: rest => obligation.condition && discharge rest

theorem discharge_iff (checks : List Obligation) :
    discharge checks = true ↔ ∀ check ∈ checks, check.condition = true := by
  induction checks with
  | nil => simp [discharge]
  | cons check rest ih => simp [discharge, ih]

/-- An operational termination certificate, counting the final return step. -/
inductive DischargeSteps : List Obligation → Bool → Nat → Prop
  | done : DischargeSteps [] true 1
  | reject {check : Obligation} {rest : List Obligation} :
      check.condition = false → DischargeSteps (check :: rest) false 1
  | pass {check : Obligation} {rest : List Obligation} {result : Bool} {steps : Nat} :
      check.condition = true → DischargeSteps rest result steps →
      DischargeSteps (check :: rest) result (steps + 1)

theorem discharge_steps_sound {checks : List Obligation} {result : Bool} {steps : Nat}
    (h : DischargeSteps checks result steps) : discharge checks = result := by
  induction h with
  | done => rfl
  | reject condition => simp [discharge, condition]
  | pass condition rest ih => simp [discharge, condition, ih]

theorem discharge_terminates (checks : List Obligation) :
    ∃ steps, steps ≤ checks.length + 1 ∧ DischargeSteps checks (discharge checks) steps := by
  induction checks with
  | nil => exact ⟨1, by decide, .done⟩
  | cons check rest ih =>
      obtain ⟨steps, bound, run⟩ := ih
      cases condition : check.condition with
      | false =>
          refine ⟨1, by simp, ?_⟩
          simpa [discharge, condition] using DischargeSteps.reject (rest := rest) condition
      | true =>
          refine ⟨steps + 1, ?_, ?_⟩
          · simp only [List.length_cons]
            omega
          · simpa [discharge, condition] using DischargeSteps.pass condition run

theorem generated_checks_discharge (command : Command) :
    discharge (obligations command) = true := by
  simp [obligations_empty, discharge]

theorem generated_discharge_one_step (command : Command) :
    DischargeSteps (obligations command) true 1 := by
  rw [obligations_empty]
  exact .done

/-- This source-level mathematical procedure uses no developer annotations. -/
def automaticDischarge (source : Source) : Option Bool :=
  if accepts source then some (discharge (obligations admittedCommand)) else none

theorem automatic_discharge_complete {source : Source} (h : Member source) :
    automaticDischarge source = some true := by
  simp [automaticDischarge, accepts_complete source h, generated_checks_discharge]

theorem automatic_discharge_sound {source : Source}
    (h : automaticDischarge source = some true) : Member source := by
  cases accepted : accepts source with
  | false => simp [automaticDischarge, accepted] at h
  | true => exact accepts_sound source accepted

/-- Whole-language assurance: every admitted source, every initial state, every run. -/
theorem admitted_assurance {source : Source} (h : Member source) :
    SourceMeaning source admittedCommand ∧
    obligations admittedCommand = [] ∧
    automaticDischarge source = some true ∧
    ∀ state, Executes admittedCommand state [] (.normal state) ∧
      ∀ trace outcome, Executes admittedCommand state trace outcome →
        trace = [] ∧ outcome = .normal state ∧
          BronzeSafe state trace ∧ SilverSafe outcome := by
  refine ⟨member_has_meaning h, obligations_empty _, automatic_discharge_complete h, ?_⟩
  intro state
  refine ⟨execution_exists _ _, ?_⟩
  intro trace outcome execution
  have identity := execution_identity execution
  have safety := execution_safe execution
  exact ⟨identity.1, identity.2, safety.1, safety.2⟩

end Semantics
end Silver
