structure Checked (tokens : List String) : Prop where
  trees : CheckedTrees
  headers : ∀ item ∈ headers, functionHeader item.1 item.2.1 tokens = some item.2.2
  expressions : ∀ item ∈ expressions, expressionDeclaration item.1 tokens = some (item.2.1, item.2.2)
  ordinary : ∀ item ∈ ordinary, Compose.BooleanDeclarationNative.SourceChecks.ordinaryFunction item.1 tokens = some item.2
  loops : ∀ item ∈ loops, Compose.BooleanDeclarationNative.SourceChecks.ordinaryFunction item.1 tokens = some item.2
  actualResult : Silver.Lexical.SourceBridge.recordDeclaration "procedure_actual_result" tokens =
    some (["record", "first", ",", "after", ":", "literal_position", ";", "scalar", ":", "scalar_expressions", ".", "binding_count", ";", "flag", ":", "boolean_count", ";", "end", "record"])
  invalidActual : Source.declaration "invalid_procedure_actual" tokens =
    some (["constant", "procedure_actual_result", ":=", "(", "0", ",", "0", ",", "0", ",", "0", ")"])

end Silver.Predicate.ProcedureCallNative.SourceChecks
