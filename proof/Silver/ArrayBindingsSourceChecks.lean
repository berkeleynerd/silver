theorem actual_headers : Headers := by
  unfold Headers
  repeat' apply And.intro
  all_goals decide +kernel

structure CheckedSource : Prop where
  shape : ReviewedShape
  expressions : ExpressionTranslation
  headers : Headers

theorem checked_source : CheckedSource := ⟨actual_shape, actual_expressions, actual_headers⟩

/-- Exact Boolean equivalence on the complete native field domains, including
empty or malformed active prefixes. No successful-caller invariant narrows a
metadata helper's precondition. -/
theorem checked_preconditions : CheckedSource ∧
    (∀ text, Native.ValidText text → ∀ names, Native.MetadataType names →
      Native.validMetadataBody.eval Native.modelCalls ({text,names} : Native.Context).locals =
        decide (ValidTable text names)) ∧
    (∀ text, Native.ValidText text → ∀ environment, Native.EnvironmentType environment →
      Native.validEnvironmentBody.eval Native.modelCalls ({text,environment} : Native.Context).locals =
        decide (ValidNativeEnvironment text environment)) :=
  ⟨checked_source,
    Native.validMetadata_meaning Native.modelCalls Native.model_primitives (fun _ _ => rfl) (fun _ _ _ _ => rfl),
    Native.validEnvironment_meaning Native.modelCalls (fun _ _ _ _ => rfl)⟩

end Silver.ArrayBindings.SourceChecks
