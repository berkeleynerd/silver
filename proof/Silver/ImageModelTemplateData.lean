/-- The one-based native pair of division/modulo subscripts. -/
def byteAt (kind : Kind) (position : Nat) : Nat :=
  ((chunkBytes kind)[(position - 1) / 128]?.getD [])[(position - 1) % 128]?.getD 0

/-- Native padding lies beyond the externally exposed content length. -/
def bytes (kind : Kind) : List Nat := (chunkBytes kind).flatten.take (length kind)

def templateKind : Native.Theory → Kind
  | .integer => .integer
  | .string => .string
  | .image => .image

def tables : Native.Tables where
  length kind := length (templateKind kind)
  byte kind := byteAt (templateKind kind)

