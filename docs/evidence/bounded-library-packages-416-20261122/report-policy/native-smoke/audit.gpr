with "containers.gpr";
project Audit is
   for Source_Dirs use (".", "../../src");
   for Object_Dir use "out/obj";
   for Exec_Dir use "out/bin";
   for Main use ("check.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Audit;
