      "text": "let c_app s vl ityl ity =\n  let cty = cty_apply s.rs_cty vl ityl ity in\n  let cty = if ityl = [] && is_rs_tuple s then cty_tuple vl else cty in\n  mk_cexp (Capp (s,vl)) cty\n"
    },
