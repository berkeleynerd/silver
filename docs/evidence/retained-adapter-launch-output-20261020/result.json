      "text": "void shutdown_with_msg(char* msg) {\n  if (server_sock != -1) {\n    close(server_sock);\n  }\n  if (clients != NULL) {\n     for (int i = 0; i < list_length(clients); i++) {\n       close(((pclient) clients->data[i])->fd);\n     }\n  }\n  kill_all_processes();\n  unlink(socketname);\n  logging_shutdown(msg);\n}\n"
    },
