      "first": 17,
      "last": 42,
      "text": "FILE* logfile;\n\nvoid init_logging() {\n  if (logging) {\n   logfile = fopen(\"why3server.log\", \"w\");\n  }\n}\n\nvoid log_msg(char* fmt, ...) {\n  if (logging) {\n    va_list va;\n    va_start(va, fmt);\n    vfprintf(logfile, fmt, va);\n    fprintf(logfile, \"\\n\");\n    fflush (logfile);\n    va_end(va);\n  }\n}\n\nvoid logging_shutdown(char* s) {\n  if (logging) {\n    log_msg(\"%s\",s);\n    fclose(logfile);\n  }\n  exit(1);\n}\n"
    },
