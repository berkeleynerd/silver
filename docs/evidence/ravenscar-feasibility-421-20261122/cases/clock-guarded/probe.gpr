project Probe is
   for Source_Dirs use ("src");
   for Source_Files use ("main.adb", "bounded_probe.ads", "bounded_probe.adb");
   for Object_Dir use "out/obj";
   for Exec_Dir use "out/bin";
   for Main use ("main.adb");
   package Builder is
      for Global_Configuration_Pragmas use "ravenscar.adc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-g");
   end Compiler;
end Probe;
