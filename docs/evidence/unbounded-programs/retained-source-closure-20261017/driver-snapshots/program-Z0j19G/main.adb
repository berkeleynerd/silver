with Silver_IO;with Silver_Arguments;procedure Main is pragma SPARK_Mode(On);Input:constant String:=Silver_Arguments.First_Or_Default("old");A:Integer range 0..9:=7;N:Integer range 0..9:=0;S:String:="x";begin if Silver_Arguments.Input_Is_Valid then for I in 20..10 loop A:=0;A:=A;if I<0 then null;end if;S:=Integer'Image((I + 2147483647));Silver_IO.Put_Line(Integer'Image((I + 2147483647)));for J in 5..I loop A:=0;end loop;end loop;for I in reverse 20..10 loop A:=0;end loop;for I in 10..N loop A:=0;end loop;for I in 1..2 loop for J in 5..I loop A:=I;end loop;end loop;Silver_IO.Put_Line(Integer'Image(A)&"/"&S);else Silver_Arguments.Reject;end if;end Main;