        "bytes": 768,
        "sha256": "0181252b53768a93f16f92dcb51a0cc81986cd05f4c8ceb3ffa3ad97c3859463"
      },
      "ordered_anchors": [
        "Finished",
        "Hashtbl.find saved_data id",
        "Hashtbl.remove saved_data id",
        "Sys.remove save.vc_file",
        "parse_prover_run",
        "| Started id",
        "List.map handle_answer"
      ]
    },
    {
      "label": "one ID and saved insertion before send; orphan possible",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/driver/call_provers.ml",
