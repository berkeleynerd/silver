  "source_audit_ranges": [
    {
      "label": "consume before singleton return",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/gnat/gnat_checks.ml",
      "first_line": 272,
      "last_line": 280,
      "identity": {
        "bytes": 331,
        "sha256": "6e7e682b3dcb8a53efbcdbd410f6da234fe2fcf277e5c84f56b4a7fef18c47bf"
      },
      "ordered_anchors": [
        "let goal = GoalSet.choose",
        "GoalSet.remove check_rec.to_be_scheduled goal;",
        "[goal]"
      ]
    },
    {
      "label": "parallel excludes reinsertion; full split excludes clones",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/gnat/gnat_checks.ml",
      "first_line": 618,
      "last_line": 642,
      "identity": {
        "bytes": 1315,
        "sha256": "444afd4dc27b20d3e04d38d47a4761a3a7071cc8f05e138264bf8392c6ce00b4"
      },
      "ordered_anchors": [
        "Gnat_config.parallel = 1",
        "GoalSet.add check_rec.to_be_scheduled goal;",
        "if is_full_split_goal",
        "further_split",
        "List.iter (add_clone goal)"
      ]
    },
    {
      "label": "remaining protected; only Done forwards; one prover traversal",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/gnat/gnat_checks.ml",
      "first_line": 1049,
      "last_line": 1084,
      "identity": {
        "bytes": 1421,
        "sha256": "1156283614cb942b0ce3374ea389547eeedfda2f67588d115d882ee1410ed372"
      },
      "ordered_anchors": [
        "let remaining = ref (List.length provers)",
        "if Gnat_config.logging then Logging.log",
        "if !remaining = 0 then ()",
        "Controller_itp.Done pr",
        "remaining := !remaining - 1",
        "C.interrupt_proof_attempts_for_goal c g",
        "remaining := 0",
        "| _ -> ()",
        "List.iter (fun p -> schedule_goal_with_prover ~callback c g p) provers"
      ]
    },
    {
      "label": "controller Hpan starts empty",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 124,
      "last_line": 136,
      "identity": {
        "bytes": 338,
        "sha256": "b8a54730aa405eff30ff1a00b3d2ffbcfbba4f471a03044036228a0fd5aa96e5"
      },
      "ordered_anchors": [
        "controller_running_proof_attempts = Hpan.create 17"
      ]
    },
    {
      "label": "queue, live table and running counter start empty/zero",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 307,
      "last_line": 334,
      "identity": {
        "bytes": 854,
        "sha256": "a07335d26299845adfdde50c361a4e63a762525c3fbb549aa5c3fc08777cc2b7"
      },
      "ordered_anchors": [
        "Queue.create ()",
        "let prover_tasks_in_progress",
        "Hashtbl.create 17",
        "let number_of_running_provers = ref 0"
      ]
    },
    {
      "label": "initial live record is not started; fresh replace precedes Sys_error catch",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 429,
      "last_line": 440,
      "identity": {
        "bytes": 463,
        "sha256": "971da6e067ec1361fcc189913e5d1efb96c9e0678fafbc31c9c981bd31ec80bf"
      },
      "ordered_anchors": [
        "let call = Driver.prove_task",
        "tp_started  = false",
        "Hashtbl.replace prover_tasks_in_progress call pa",
        "with Sys_error"
      ]
    },
    {
      "label": "receive and dispatch; guarded decrements; lookup-only exception pattern",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 448,
      "last_line": 491,
      "identity": {
        "bytes": 2186,
        "sha256": "9c03021cc546418968100f0f8227eb301e3f83a0cda209d59fa34642deba158b"
      },
      "ordered_anchors": [
        "Call_provers.get_new_results ~blocking:S.blocking",
        "List.iter",
        "match Hashtbl.find",
        "| Call_provers.ProverStarted",
        "incr number_of_running_provers",
        "tp_started = true",
        "| Call_provers.ProverFinished",
        "Hashtbl.remove prover_tasks_in_progress",
        "if ptp.tp_started then decr",
        "ptp.tp_callback (Done res)",
        "| Call_provers.ProverInterrupted",
        "Hashtbl.remove prover_tasks_in_progress",
        "if ptp.tp_started then decr",
        "ptp.tp_callback (Interrupted)",
        "| Call_provers.InternalFailure",
        "Hashtbl.remove prover_tasks_in_progress",
        "if ptp.tp_started then decr",
        "ptp.tp_callback (InternalFailure",
        "| exception Not_found -> ()"
      ]
    },
    {
      "label": "pop consumes owner before build and failure callback",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 517,
      "last_line": 536,
      "identity": {
        "bytes": 661,
        "sha256": "fc3c55eda8d07d07ab8da03af2f7834a2b7b625a36ea381d4944cfdda76eb908"
      },
      "ordered_anchors": [
        "if S.blocking ||",
        "S.multiplier * !session_max_tasks",
        "Queue.pop scheduled_proof_attempts",
        "build_prover_call spa",
        "with e when",
        "spa.spa_callback (InternalFailure e)",
        "with Queue.Empty"
      ]
    },
    {
      "label": "cancellation traverses live table then clear/rebuilds survivors",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 560,
      "last_line": 576,
      "identity": {
        "bytes": 732,
        "sha256": "02ee25796a6e83e4b543644c48c0fa26eaa44675d97815adc27f7d71ab5f04a5"
      },
      "ordered_anchors": [
        "Hashtbl.iter",
        "Call_provers.interrupt_call",
        "Queue.fold",
        "x.spa_callback Interrupted",
        "Queue.clear scheduled_proof_attempts",
        "Queue.add x scheduled_proof_attempts"
      ]
    },
    {
      "label": "Scheduled only adds controller Hpan; terminal statuses remove",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 592,
      "last_line": 617,
      "identity": {
        "bytes": 1018,
        "sha256": "a25df161df20328b264a5075ea49be7545468ffebb3d4c4f6ab3ae92f3d9f829"
      },
      "ordered_anchors": [
        "| Scheduled ->",
        "Hpan.add c.controller_running_proof_attempts",
        "| Done res ->",
        "Hpan.remove c.controller_running_proof_attempts",
        "| InternalFailure _ ->",
        "Hpan.remove c.controller_running_proof_attempts",
        "callback panid s"
      ]
    },
    {
      "label": "graft then one enqueue/Scheduled/idle",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/session/controller_itp.ml",
      "first_line": 641,
      "last_line": 652,
      "identity": {
        "bytes": 370,
        "sha256": "e56de0f06e6bb4c4c7fc2d12d58c9889ca370259ab98451484b4c2deb60a04fa"
      },
      "ordered_anchors": [
        "let panid = graft_proof_attempt",
        "Queue.add spa scheduled_proof_attempts",
        "callback panid Scheduled",
        "run_idle_handler ()"
      ]
    },
    {
      "label": "fresh private request IDs and saved-data table",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/driver/call_provers.ml",
      "first_line": 460,
      "last_line": 474,
      "identity": {
        "bytes": 333,
        "sha256": "9deb0f2402ad6b7c443749c0771f524be49c58a98e0a0eb951b8bd13f48aec65"
      },
      "ordered_anchors": [
        "let x = ref 0",
        "incr x",
        "!x",
        "let saved_data",
        "Hashtbl.create 17"
      ]
    },
    {
      "label": "F removes saved owner before cleanup/parse",
      "archive": "docs/evidence/retained-why-session-helper-source-20261019/sources.tar.gz",
      "member": "why3/src/driver/call_provers.ml",
      "first_line": 478,
