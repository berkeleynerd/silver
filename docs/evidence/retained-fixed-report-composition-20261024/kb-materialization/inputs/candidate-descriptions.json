[
  {
    "description": "G++_Pro",
    "file": "db/compilers.xml",
    "pattern": "(.*-elf-.*|.*-eabi-.*|.*-wrs-.*|.*-fastos.*|.*-freebsd.*|.*-linux-gnu.*-|.*-linux-android.*|.*-rtems.*)?g\\+\\+",
    "matches": [
      "x86_64-pc-linux-gnu-g++"
    ],
    "xml": "<compiler_description>\n    <name>G++_Pro</name>\n    <executable prefix=\"1\">(.*-elf-.*|.*-eabi-.*|.*-wrs-.*|.*-fastos.*|.*-freebsd.*|.*-linux-gnu.*-|.*-linux-android.*|.*-rtems.*)?g\\+\\+</executable>\n    <version>\n      <external>${PREFIX}g++ -v</external>\n\n      \n      <grep regexp=\"^gcc \\S+ (\\S+) \\d+ \\(?for GNAT Pro\" group=\"1\" />\n    </version>\n    <languages>C++</languages>\n    <target>\n      <external>${PREFIX}g++ -dumpmachine</external>\n      <grep regexp=\"[^\\r\\n]+\" />\n    </target>\n  </compiler_description>\n\n  \n  "
  },
  {
    "description": "GCC",
    "file": "db/compilers.xml",
    "pattern": "(.*-wrs-.*|.*-sysgo.*|.*-elf-.*|.*-eabi-.*|.*-eabispe-.*|avr-.*|.*-elinos-linux.*|.*-linux-gnu-|.*mingw32.*|.*-xcoff-.*|.*linux-android.*|arm-linux-gnueabi-|arm-linux-gnueabihf-|e500v2-gnu-linux-|powerpc-.*-linux.*-|.*-darwin.*-|.*-freebsd.*)?gcc(-\\d+)?",
    "matches": [
      "gcc",
      "x86_64-pc-linux-gnu-gcc"
    ],
    "xml": "<compiler_description>\n    <name>GCC</name>\n    <executable prefix=\"1\">(.*-wrs-.*|.*-sysgo.*|.*-elf-.*|.*-eabi-.*|.*-eabispe-.*|avr-.*|.*-elinos-linux.*|.*-linux-gnu-|.*mingw32.*|.*-xcoff-.*|.*linux-android.*|arm-linux-gnueabi-|arm-linux-gnueabihf-|e500v2-gnu-linux-|powerpc-.*-linux.*-|.*-darwin.*-|.*-freebsd.*)?gcc(-\\d+)?</executable>\n    <version>\n      <external>$EXEC -v</external>\n      <nogrep regexp=\"for GNAT Pro\" />\n      <grep regexp=\"^gcc \\S+ (\\S+)\" group=\"1\" />\n    </version>\n    <languages>C</languages>\n    <target>\n      <external>$EXEC -dumpmachine</external>\n      <grep regexp=\"[^\\r\\n]+\" />\n    </target>\n  </compiler_description>\n\n  \n  "
  },
  {
    "description": "GCC-28",
    "file": "db/compilers.xml",
    "pattern": "gcc",
    "matches": [
      "gcc"
    ],
    "xml": "<compiler_description>\n    <name>GCC-28</name>\n    <executable>gcc</executable>\n    <version>\n      <external>gcc -v</external>\n      <grep regexp=\"^gcc \\S+ (\\S+)\" group=\"1\" />\n      <must_match>2\\.8\\.</must_match>\n    </version>\n    <languages>C</languages>\n    <target>\n      <external>gcc -dumpmachine</external>\n      <grep regexp=\"[^\\r\\n]+\" />\n    </target>\n  </compiler_description>\n\n  \n  "
  },
  {
