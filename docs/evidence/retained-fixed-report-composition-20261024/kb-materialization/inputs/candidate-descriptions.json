  {
    "description": "GCC-CYGMING",
    "file": "db/compilers.xml",
    "pattern": "gcc",
    "matches": [
      "gcc"
    ],
    "xml": "<compiler_description>\n    <name>GCC-CYGMING</name>\n    <executable>gcc</executable>\n    <version>\n      <external>gcc --version</external>\n      <grep regexp=\"\\(GCC\\) (\\S+).*\\(cygming special\\)\" group=\"1\" />\n    </version>\n    <languages>C,C++,Fortran</languages>\n    <target>\n      <external>gcc -mno-cygwin -dumpmachine</external>\n      <grep regexp=\"[^\\r\\n]+\" />\n    </target>\n  </compiler_description>\n\n  "
  },
  {
