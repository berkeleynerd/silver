    "output_string !outc \"\\n\"",
    "if Gnat_config.logging then Logging.init ()",
    "if Gnat_config.logging then Logging.log g prover pas",
    "let opt_logging = ref false",
    "\"--logging\", Arg.Set opt_logging",
    "let () = Arg.parse options set_filename usage_msg",
    "let logging = !opt_logging",
    "with Not_found -> raise BadID",
    "(get_proofNode s id).proofn_parent",
    "Printexc.print_backtrace stderr",
    "| Bad msg -> eprintf \"%s\" msg; exit 2",
    "| Help msg -> printf \"%s\" msg; exit 0",
    "let create fn arg =",
    "channel->offset = lseek(fd, 0, SEEK_CUR)",
    "channel->curr = channel->max = channel->buff",
    "channel->max = NULL",
    "Channel(res) = chan",
