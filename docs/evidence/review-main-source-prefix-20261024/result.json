  "supplemental_source": [
    {
      "archive": "docs/evidence/retained-producer-prefix-composition-20261018/sources.tar.gz",
      "path": "src/mlw/pmodule.ml",
      "complete_sha256": "0bbebf874d1fe1ed216efd07a76f6e51d9fd96c5910ea9c1fac2f5864db29344",
      "first": 1646,
      "last": 1671,
      "sha256": "9de279f6ae764672483e441d98535c5a81a333f1845b7048e4f29ff223528e3c",
      "source": "      mi_pv = Mvs.map (cl_find_pv impl_cl) inst.mi_pv;\n      mi_rs = Mrs.map (cl_find_rs impl_cl) inst.mi_rs;\n      mi_xs = Mxs.map (cl_find_xs impl_cl) inst.mi_xs;\n      mi_df = inst.mi_df\n    } in\n  impl_cl.cl_local <- Sid.union impl_cl.cl_local m.mod_local;\n  let mimpl' = clone_export' mimpl' m inst impl_cl in\n  let mimpl' = close_scope mimpl' ~import:false in\n  let mimpl' = close_module mimpl' in\n  Wid.set mod_table mimpl.mod_theory.th_name mimpl';\n  Wid.set mod_table m.mod_theory.th_name mimpl'\n\n(** {2 WhyML language} *)\n\ntype mlw_file = pmodule Mstr.t\n\nlet convert mm =\n  let convert m = m.mod_theory in\n  if Mstr.is_empty mm then Mstr.empty else\n  match (snd (Mstr.choose mm)).mod_theory.th_path with\n  | \"why3\" :: path ->\n      begin try Env.base_language_builtin path\n      with Not_found -> Mstr.map convert mm end\n  | _ -> Mstr.map convert mm\n\nlet mlw_language = Env.register_language Env.base_language convert\n"
    },
    {
      "archive": "docs/evidence/retained-producer-prefix-composition-20261018/sources.tar.gz",
      "path": "src/util/debug.ml",
      "complete_sha256": "38ec7370a02da7d9630745e28bd6efcdec29d3cf6894d0dacaa38df8f7e5a8a1",
      "first": 44,
      "last": 51,
      "sha256": "6e469b750797a4ae96d033bc152966dd244e17c8c9c9fb68075186fe2a5fdbe4",
      "source": "  try fst3 (Hashtbl.find flag_table s) with Not_found -> raise (UnknownFlag s)\n\nlet test_flag s = s.flag_value\nlet test_noflag s = not s.flag_value\n\nlet set_flag s = s.flag_value <- true\nlet unset_flag s = s.flag_value <- false\nlet toggle_flag s = s.flag_value <- not s.flag_value\n"
    },
    {
      "archive": "docs/evidence/retained-producer-prefix-composition-20261018/sources.tar.gz",
      "path": "src/util/extmap.ml",
      "complete_sha256": "af5523e85a6714c04cbb2faed6a33b7560af63bbf185acde33f7d0a9500ee875",
      "first": 163,
      "last": 179,
      "sha256": "a3f043f9cd1b4c83262b2f44ece92fe6a680313f6f9e1a6cb03381ed4099aab1",
      "source": "    let rec find x = function\n        Empty ->\n          raise Not_found\n      | Node(l, v, d, r, _) ->\n          let c = Ord.compare x v in\n          if c = 0 then d\n          else find x (if c < 0 then l else r)\n\n    let rec mem x = function\n        Empty ->\n          false\n      | Node(l, v, _, r, _) ->\n          let c = Ord.compare x v in\n          c = 0 || mem x (if c < 0 then l else r)\n\n    let rec min_binding = function\n        Empty -> raise Not_found\n"
    },
    {
      "archive": "docs/evidence/retained-producer-prefix-composition-20261018/sources.tar.gz",
      "path": "src/util/extmap.ml",
      "complete_sha256": "af5523e85a6714c04cbb2faed6a33b7560af63bbf185acde33f7d0a9500ee875",
      "first": 509,
      "last": 517,
      "sha256": "cb54f98cd1eed15cc8e8b977041e605fc86f96ad3434db8d2a1ccd663ca824c0",
      "source": "    let rec find_exn exn x = function\n        Empty -> raise exn\n      | Node(l, v, d, r, _) ->\n          let c = Ord.compare x v in\n          if c = 0 then d\n          else find_exn exn x (if c < 0 then l else r)\n\n    let rec map_filter f = function\n        Empty -> Empty\n"
    },
